---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}
const { currentPage, totalPages, baseUrl } = Astro.props;
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
const href = (p: number) => (p === 1 ? baseUrl : `${baseUrl}page/${p}/`);
---

{totalPages > 1 && (
  <nav class="pagination">
    {currentPage > 1 && <a href={href(currentPage - 1)}>上一页</a>}
    {pages.map((p) =>
      p === currentPage ? (
        <span class="current">{p}</span>
      ) : (
        <a href={href(p)}>{p}</a>
      )
    )}
    {currentPage < totalPages && <a href={href(currentPage + 1)}>下一页</a>}
  </nav>
)}
