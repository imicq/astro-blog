---
import site from '../config/site';

interface Props {
  /** 传页面标识则启用该页评论计数；不传则加载完整评论框 */
  countEl?: never;
}
---

<div id="tcomment">
  <div class="twikoo-loading" style="color:var(--muted);text-align:center;padding:20px 0;font-size:.9rem">评论加载中…</div>
</div>

<script is:inline define:vars={{ envId: site.twikooEnvId }}>
  function loadTwikoo() {
    if (!window.twikoo) {
      const s = document.createElement('script');
      // 主源用国内可直连的 npmmirror，jsdelivr 兜底
      s.src = 'https://registry.npmmirror.com/twikoo/1.6.44/files/twikoo.all.min.js';
      s.onerror = function () {
        const s2 = document.createElement('script');
        s2.src = 'https://cdn.jsdelivr.net/npm/twikoo@1.6.44/twikoo.all.min.js';
        s2.onload = init;
        s2.onerror = fail;
        document.head.appendChild(s2);
      };
      s.onload = init;
      document.head.appendChild(s);
    } else {
      init();
    }
    function init() {
      if (!envId) return fail('未配置评论环境地址');
      twikoo.init({
        envId: envId,
        el: '#tcomment',
        onCommentLoaded: function () {},
      });
    }
    function fail(msg) {
      const box = document.querySelector('#tcomment .twikoo-loading');
      if (box) box.textContent = (msg || '评论加载失败') + '（若站点使用临时预览域名，评论功能需绑定正式域名后才可用）';
    }
  }
  loadTwikoo();
</script>
