---
import site from '../config/site';

interface Props {
  /** 传页面标识则启用该页评论计数；不传则加载完整评论框 */
  countEl?: never;
}
---

<div id="tcomment">
  <div class="twikoo-loading" style="color:var(--muted);text-align:center;padding:20px 0;font-size:.9rem">评论加载中…</div>
</div>

<script is:inline define:vars={{ envId: site.twikooEnvId }}>
  function loadTwikoo() {
    if (!window.twikoo) {
      const s = document.createElement('script');
      // 优先同源本地脚本（已随博客构建），失败再用公共 CDN 兜底
      s.src = '/js/twikoo.all.min.js';
      s.onerror = function () {
        const s2 = document.createElement('script');
        s2.src = 'https://registry.npmmirror.com/twikoo/1.6.44/files/dist/twikoo.all.min.js';
        s2.onload = init;
        s2.onerror = function () { fail('评论脚本加载失败，请检查网络'); };
        document.head.appendChild(s2);
      };
      s.onload = init;
      document.head.appendChild(s);
    } else {
      init();
    }
    function init() {
      if (!envId) return fail('未配置评论环境地址');
      twikoo.init({
        envId: envId,
        el: '#tcomment',
        onCommentLoaded: function () {},
      });
    }
    function fail(msg) {
      const box = document.querySelector('#tcomment .twikoo-loading');
      if (box) box.textContent = msg || '评论加载失败';
    }
  }
  loadTwikoo();
</script>
