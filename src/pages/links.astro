---
import links from '../data/links.json';
import site from '../config/site';
import Base from '../layouts/Base.astro';
---

<Base title="友链">
  <h1 class="page-title">友情链接</h1>
  <div class="card">
    <div class="link-grid">
      {links.map((l: any) => (
        <a class="link-card" href={l.url} target="_blank" rel="noopener">
          <img src={l.avatar} alt={l.name} loading="lazy" onerror="this.src='/images/avatar.svg'" />
          <span>
            <span class="name">{l.name}</span><br />
            <span class="desc">{l.desc}</span>
          </span>
        </a>
      ))}
    </div>
    {links.length === 0 && <p>暂无友链</p>}
    {site.linksIntro && (
      <>
        <hr style="border:none;border-top:1px solid var(--border);margin:20px 0" />
        <h3>申请友链</h3>
        <div class="links-intro">{site.linksIntro}</div>
      </>
    )}
  </div>
</Base>

<style>
  .links-intro {
    white-space: pre-line;
    line-height: 1.9;
    color: var(--text-light);
  }
</style>
