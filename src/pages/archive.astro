---
import { getSortedPosts, slugOf } from '../utils/posts';
import Base from '../layouts/Base.astro';

const posts = await getSortedPosts();
const currentYear = new Date().getFullYear();

// 按年 → 月两级分组（月内按时间倒序，posts 本身已按时间倒序）
const byYear: Record<string, Record<string, typeof posts>> = {};
for (const p of posts) {
  const d = p.data.date;
  const y = String(d.getFullYear());
  const m = String(d.getMonth() + 1).padStart(2, '0');
  (byYear[y] ||= {})[m] ||= [];
  byYear[y][m].push(p);
}
const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));
const fmtDay = (d: Date) => `${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<Base title="归档">
  <h1 class="page-title">文章归档</h1>
  <div class="card">
    <p style="color:var(--text-light);margin:0 0 8px">共 {posts.length} 篇文章</p>
    {years.map((y) => {
      const months = Object.keys(byYear[y]).sort((a, b) => Number(b) - Number(a));
      const count = posts.filter((p) => String(p.data.date.getFullYear()) === y).length;
      const isCurrent = Number(y) === currentYear;
      const monthBlocks = months.map((m) => (
        <section class="archive-month">
          <h3>{y} 年 {Number(m)} 月 · {byYear[y][m].length} 篇</h3>
          <ul class="timeline">
            {byYear[y][m].map((p) => (
              <li class="timeline-item">
                <span class="time">{fmtDay(p.data.date)}</span>
                <a href={`/${slugOf(p.id)}.html`}>{p.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      ));
      return isCurrent
        ? monthBlocks
        : (
        <details class="archive-year">
          <summary>{y} 年 · {count} 篇（点击展开）</summary>
          {monthBlocks}
        </details>
        );
    })}
  </div>
</Base>

<style>
  .archive-month h3 {
    margin: 18px 0 6px;
    font-size: 1.02rem;
    color: var(--accent);
  }
  .archive-year {
    margin-top: 10px;
  }
  .archive-year summary {
    cursor: pointer;
    font-size: 1.05rem;
    font-weight: 600;
    padding: 8px 12px;
    margin: 6px 0;
    border-radius: 8px;
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    user-select: none;
  }
  .archive-year summary:hover {
    color: var(--accent);
  }
  .archive-year[open] summary {
    margin-bottom: 4px;
  }
  .timeline-item .time {
    margin-right: 10px;
  }
</style>
